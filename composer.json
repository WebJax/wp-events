{
  "name": "webjax/wp-events",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1",
    "automattic/blocks-engine-php-transformer": "0.1.0"
  },
  "autoload": {
    "psr-4": {
      "WPEvents\\": "src/"
    },
    "files": [
      "src/functions-templates.php"
    ]
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "automattic/blocks-engine-php-transformer",
        "version": "0.1.0",
        "source": {
          "type": "git",
          "url": "https://github.com/Automattic/blocks-engine.git",
          "reference": "php-transformer-v0.1.0"
        },
        "autoload": {
          "psr-4": {
            "Automattic\\BlocksEngine\\PhpTransformer\\": "php-transformer/src/"
          }
        },
        "require": {
          "php": ">=8.1",
          "league/commonmark": "^2.5",
          "league/html-to-markdown": "^5.1"
        }
      }
    }
  ]
}
